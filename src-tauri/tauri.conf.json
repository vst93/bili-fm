{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bili-FM",
  "version": "2.0.1-preview",
  "identifier": "com.bili-fm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bili-FM",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost http://127.0.0.1:4654; style-src 'self' 'unsafe-inline'; media-src 'self' data: blob: http://127.0.0.1:4654 https://*.bilivideo.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
